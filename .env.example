# Copy to .env (gitignored) or set these in your shell.
#
# The assistant answers most phrasings locally and for free. A key is only
# needed so it can interpret wording the local matcher does not recognise.
GEMINI_API_KEY=your-key-here

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-2.0-flash
# AEGIS_ASSISTANT_MAX_CALLS=150          # session ceiling; 0 disables model calls
# AEGIS_ASSISTANT_MAX_OUTPUT_TOKENS=120  # hard cap on each reply
# AEGIS_ASSISTANT_TIMEOUT=12

# Redirect evidence output (the test suite sets this automatically).
# AEGIS_RESULTS_DIR=/tmp/aegis-results
